{
  "format_version": "1.20.0",
  "minecraft:entity": {
    "description": {
      "identifier": "mm:forest_guardian",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "mm:forest_guardian_angry": {
        "minecraft:angry": {
          "duration": 15,
          "duration_delta": 5,
          "calm_event": {
            "event": "mm:become_calm",
            "target": "self"
          }
        },
        "minecraft:on_target_escape": {
          "event": "mm:become_calm",
          "target": "self"
        }
      },
      "mm:forest_guardian_enraged": {
        "minecraft:movement": {
          "value": 0.4
        },
        "minecraft:attack": {
          "damage": 10
        },
        "minecraft:scale": {
            "value": 1.5
        }
      },
      "mm:forest_guardian_healing": {
        "minecraft:healable": {
          "items": [],
          "on_heal": [
            {
              "event": "mm:heal_tick",
              "target": "self"
            }
          ]
        },
        "minecraft:scheduler": {
            "scheduled_events": [
                {
                    "event": "mm:heal_tick",
                    "time": 2.0,
                    "looping": true
                }
            ]
        }
      }
    },
    "components": {
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 15 : 0"
      },
      "minecraft:type_family": {
        "family": [ "forest_guardian", "mob" ]
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/forest_guardian.json"
      },
      "minecraft:health": {
        "value": 50,
        "max": 50
      },
      "minecraft:attack": {
        "damage": 7
      },
      "minecraft:movement": {
        "value": 0.25
      },
      "minecraft:navigation.walk": {
        "can_path_over_water": true
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:collision_box": {
        "width": 1.4,
        "height": 2.9
      },
      "minecraft:nameable": {},
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:behavior.melee_attack": {
        "priority": 2,
        "speed_multiplier": 1.5,
        "track_target": true
      },
      "minecraft:behavior.random_stroll": {
        "priority": 3,
        "speed_multiplier": 1.0
      },
      "minecraft:behavior.look_at_player": {
        "priority": 4,
        "look_distance": 8.0
      },
      "minecraft:behavior.random_look_around": {
        "priority": 5
      },
      "minecraft:on_hurt": {
        "event": "mm:check_rage",
        "target": "self"
      }
    },
    "events": {
      "mm:become_angry": {
        "add": {
          "component_groups": [ "mm:forest_guardian_angry" ]
        },
        "remove": {
          "component_groups": [ "mm:forest_guardian_healing" ]
        }
      },
      "mm:become_calm": {
        "remove": {
          "component_groups": [ "mm:forest_guardian_angry" ]
        },
        "add": {
          "component_groups": [ "mm:forest_guardian_healing" ]
        }
      },
      "mm:check_rage": {
        "sequence": [
            {
                "trigger": "mm:become_angry"
            },
            {
                "filters": { "test": "health", "operator": "<", "value": 15 },
                "add": { "component_groups": [ "mm:forest_guardian_enraged" ] }
            }
        ]
      },
      "mm:heal_tick": {
          "add": {
              "component_groups": []
          },
          "queue_command": {
              "command": [
                  "effect @s regeneration 2 1 true"
              ]
          }
      },
      "minecraft:entity_spawned": {
          "add": {
              "component_groups": [ "mm:forest_guardian_healing" ]
          }
      }
    }
  }
}
